# Configuração do Cloudflare R2
# Substitua os valores de exemplo pelas suas credenciais e informações reais.

# ID da chave de acesso S3
R2_ACCESS_KEY_ID=your-access-key-id

# Chave de acesso secreta S3
R2_SECRET_ACCESS_KEY=your-secret-access-key

# Endpoint compatível com S3 do R2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Bucket padrão utilizado pelo CLI
R2_BUCKET=your-bucket