# Cloudflare R2 configuration
# Replace the example values with your real credentials and information.

# S3 access key ID
R2_ACCESS_KEY_ID=your-access-key-id

# S3 secret access key
R2_SECRET_ACCESS_KEY=your-secret-access-key

# R2 S3-compatible endpoint
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Region used by the S3-compatible endpoint (default: auto)
R2_REGION=auto

# Default bucket used by the CLI
R2_BUCKET=your-bucket

# Bucket used by the tests
R2_TEST_BUCKET=test-bucket